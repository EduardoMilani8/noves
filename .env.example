# DSNs do ambiente de teste (make up). Copie para .env e ajuste se precisar.
# Firebird: usuario:senha@host:porta/caminho-do-banco (driver nakagami/firebirdsql)
NOVES_FB_DSN=noves:noves@localhost:3050/var/lib/firebird/data/erp.fdb
# PostgreSQL: URL ou "chave=valor" (pgx)
NOVES_PG_DSN=postgres://noves:noves@localhost:5433/erp?sslmode=disable
